# Copy to .devcontainer/.env. This file contains no secrets.
# Use a unique, lowercase value per clone when invoking Docker Compose directly.
COMPOSE_PROJECT_NAME=agent-devcontainer-my-project

USER_UID=1000
USER_GID=1000
CONTAINER_TIMEZONE=Etc/UTC

INSTALL_CODEX=true
CODEX_VERSION=latest
INSTALL_CLAUDE_CODE=true
CLAUDE_CODE_VERSION=latest
INSTALL_OPENCODE=true
OPENCODE_VERSION=latest
INSTALL_GITHUB_CLI=true

# Space-separated Debian package names only; options and shell syntax are rejected.
EXTRA_APT_PACKAGES=
